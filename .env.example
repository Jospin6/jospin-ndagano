# Public production origin used by canonical URLs, structured data, and sitemap.
# Keep the stable domain; do not use a Vercel preview URL.
NEXT_PUBLIC_SITE_URL=https://jospin-ndagano.vercel.app

# Google Search Console > URL-prefix property > HTML tag.
# Paste only the value of content="...", not the complete HTML tag.
# Leave empty until Google provides your token. Rebuild after changing it.
GOOGLE_SITE_VERIFICATION=
